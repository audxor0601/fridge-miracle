# 식약처 조리식품 레시피 DB 인증키
# https://www.foodsafetykorea.go.kr/api/openApiInfo.do?svc_no=COOKRCP01 에서 발급
FOODSAFETY_API_KEY=

# Supabase — 브라우저에 그대로 실려 나가는 값이다.
# anon 키는 공개되어도 된다. 데이터를 지키는 건 RLS 정책이지 키가 아니다.
# 배포할 때 Vercel 환경변수에도 이 두 개를 넣는다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase 적재 스크립트용 (관리자 키 — 절대 공개 금지)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 데모 계정 — 배포한 사이트의 '가입 없이 둘러보기' 버튼용.
# 일부러 공개하는 계정이다. 이 값으로 볼 수 있는 건 이 계정의 행뿐이고,
# 그걸 막는 건 비밀번호가 아니라 RLS다. 비워두면 버튼이 안 나온다.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=

# seed_demo.py 가 채울 계정 (위 VITE_DEMO_EMAIL 과 같은 값)
DEMO_EMAIL=
